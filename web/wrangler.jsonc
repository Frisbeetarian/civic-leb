{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "civicleb",
  "compatibility_date": "2026-09-01",
  // civ-leb.com is a zone in this account; custom domains create the DNS records automatically
  "routes": [
    { "pattern": "civ-leb.com", "custom_domain": true },
    { "pattern": "www.civ-leb.com", "custom_domain": true }
  ],
  // Static preview: the Next.js static export (pnpm build:static) served as Workers static assets.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
